---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99)
);

const allTechnologies = [...new Set(projects.flatMap((p) => p.data.technologies))].sort();
---

<BaseLayout title="Projects" description="A showcase of personal projects spanning automation, infrastructure, AI pipelines, and web development.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <!-- Header -->
    <header class="mb-12">
      <h1 class="font-display font-800 tracking-tight">
        <span class="gradient-text">Projects</span>
      </h1>
      <p class="mt-3 text-xl text-[var(--text-muted)]">
        Things I've built — from infrastructure and automation to AI pipelines and this very website.
      </p>
    </header>

    <!-- Technology filter -->
    <div class="mb-8 flex flex-wrap gap-2" id="tech-filters">
      <button
        class="filter-btn active px-3 py-1.5 text-sm rounded-full font-medium bg-[var(--color-primary)]/10 text-[var(--color-primary)] border border-[var(--color-primary)]/30 transition-colors"
        data-filter="all"
      >
        All
      </button>
      {allTechnologies.map((tech) => (
        <button
          class="filter-btn px-3 py-1.5 text-sm rounded-full font-medium text-[var(--text-muted)] border border-[var(--border)] hover:border-[var(--color-primary)]/30 hover:text-[var(--text)] transition-colors"
          data-filter={tech}
        >
          {tech}
        </button>
      ))}
    </div>

    <!-- Project list -->
    <div class="flex flex-col gap-4" id="project-grid">
      {projects.map((project) => (
        <div data-technologies={project.data.technologies.join(',')}>
          <article class="group relative">
            <a
              href={`/projects/${project.id}/`}
              class:list={[
                'flex flex-col sm:flex-row sm:items-start gap-4 p-5 rounded-2xl border transition-all duration-200',
                project.data.featured
                  ? 'border-[var(--color-primary)]/30 bg-[var(--surface)] hover:border-[var(--color-primary)]/60'
                  : 'border-[var(--border)] bg-[var(--surface)] hover:bg-[var(--surface-raised)] hover:border-[var(--color-primary)]/30',
              ]}
            >
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3">
                  {project.data.featured && (
                    <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-[var(--color-accent)]/15 text-[var(--color-accent)]">
                      Featured
                    </span>
                  )}
                </div>
                <h3 class="mt-1 text-lg font-display font-bold text-[var(--text)] group-hover:text-[var(--color-primary)] transition-colors">
                  {project.data.title}
                </h3>
                <p class="mt-1 text-sm text-[var(--text-muted)] line-clamp-2">
                  {project.data.description}
                </p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {project.data.technologies.map((tech) => (
                    <span class="px-2 py-0.5 text-xs rounded-md bg-[var(--surface-raised)] text-[var(--text-muted)] font-mono">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('#project-grid > div');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-[var(--color-primary)]/10', 'text-[var(--color-primary)]', 'border-[var(--color-primary)]/30');
          b.classList.add('text-[var(--text-muted)]', 'border-[var(--border)]');
        });
        btn.classList.add('active', 'bg-[var(--color-primary)]/10', 'text-[var(--color-primary)]', 'border-[var(--color-primary)]/30');
        btn.classList.remove('text-[var(--text-muted)]', 'border-[var(--border)]');

        items.forEach((item) => {
          const techs = item.dataset.technologies?.split(',') ?? [];
          const show = filter === 'all' || techs.includes(filter!);
          item.style.display = show ? '' : 'none';
        });
      });
    });
  }

  initFilters();
  document.addEventListener('astro:after-swap', initFilters);
</script>
