---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const resumeEntries = await getCollection('resume');
const about = resumeEntries.filter((e) => e.data.section === 'about');
---

<BaseLayout title="About" description="Jon Mooney — systems engineer, algorithm developer, self-hosting enthusiast, and automation builder based in Orlando, FL.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
    <!-- Page title -->
    <h1 class="text-2xl lg:text-3xl font-display font-800 tracking-tight mb-6">
      About <span class="gradient-text">Me</span>
    </h1>

    <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
      <!-- Main bio content -->
      <div>
        {about.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <div class="prose prose-sm max-w-none text-[var(--text-muted)]">
              <Content />
            </div>
          );
        })}
      </div>

      <!-- Sidebar: headshot + contact card -->
      <aside class="lg:order-last">
        <div class="sticky top-24 space-y-4">
          <!-- Headshot -->
          <div class="rounded-xl overflow-hidden border border-[var(--border)]">
            <img
              src="/headshot.jpg"
              alt="Jon Mooney — headshot"
              class="w-full aspect-[4/5] object-cover object-top"
              loading="eager"
            />
          </div>

          <!-- Contact info card -->
          <div class="rounded-xl bg-[var(--surface-raised)] border border-[var(--border)] p-5 overflow-hidden">
            <p class="text-[0.65rem] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3">
              Get in Touch
            </p>

            <ul class="space-y-3 text-sm">
              <!-- Location -->
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 mt-0.5 text-[var(--color-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <span class="text-[var(--text-muted)]">Orlando, FL</span>
              </li>

              <!-- Email -->
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 mt-0.5 text-[var(--color-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <a href="mailto:REDACTED_EMAIL" class="text-[var(--color-primary)] hover:underline break-all">
                  REDACTED_EMAIL
                </a>
              </li>
            </ul>

            <!-- Social links -->
            <div class="mt-5 pt-4 border-t border-[var(--border)]">
              <p class="text-[0.65rem] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2">
                Elsewhere
              </p>
              <div class="flex gap-3">
                <a
                  href="https://github.com/jmlab-net"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium text-[var(--text-muted)] bg-[var(--surface)] hover:text-[var(--text)] hover:bg-[var(--surface-raised)] border border-[var(--border)] transition-colors"
                  aria-label="GitHub profile"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                  GitHub
                </a>
                <a
                  href="https://www.linkedin.com/in/jon-m-0228361a2/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium text-[var(--text-muted)] bg-[var(--surface)] hover:text-[var(--text)] hover:bg-[var(--surface-raised)] border border-[var(--border)] transition-colors"
                  aria-label="LinkedIn profile"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                  LinkedIn
                </a>
              </div>
            </div>
          </div>

          <!-- Quick facts card -->
          <div class="rounded-xl bg-[var(--surface-raised)] border border-[var(--border)] p-5 overflow-hidden">
            <p class="text-[0.65rem] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3">
              Quick Facts
            </p>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-[var(--text-muted)]">Role</dt>
                <dd class="text-[var(--text)] font-medium text-right">Group Technical Staff</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-[var(--text-muted)]">Employer</dt>
                <dd class="text-[var(--text)] font-medium text-right">Lockheed Martin</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-[var(--text-muted)]">Experience</dt>
                <dd class="text-[var(--text)] font-medium">15+ years</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-[var(--text-muted)]">Focus</dt>
                <dd class="text-[var(--text)] font-medium text-right">Image Processing & IR</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-[var(--text-muted)]">Education</dt>
                <dd class="text-[var(--text)] font-medium text-right">BS Aerospace, UCF</dd>
              </div>
            </dl>
          </div>

          <!-- Link to CV -->
          <a
            href="/cv/"
            class="block text-center px-4 py-3 rounded-xl font-display font-600 text-sm bg-[var(--color-primary)]/10 text-[var(--color-primary)] border border-[var(--color-primary)]/20 hover:bg-[var(--color-primary)]/20 transition-colors"
          >
            View full CV &rarr;
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* Tighten bullet spacing inside about prose */
  .prose :global(ul) {
    margin-top: 0.25rem;
    margin-bottom: 0;
  }
  .prose :global(li) {
    margin-top: 0;
    margin-bottom: 0;
  }
  .prose :global(li p) {
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
