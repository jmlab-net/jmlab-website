---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const resumeEntries = await getCollection('resume');
const sorted = resumeEntries.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const about = sorted.filter((e) => e.data.section === 'about');
const experience = sorted.filter((e) => e.data.section === 'experience');
const education = sorted.filter((e) => e.data.section === 'education');
const skills = sorted.filter((e) => e.data.section === 'skills');

function formatDate(date?: Date | null): string {
  if (!date) return 'Present';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<BaseLayout title="About" description="Software engineer, homelab enthusiast, and automation obsessive. Learn more about my background and what I'm working on.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <!-- Intro -->
    <header class="mb-16">
      <h1 class="font-display font-800 tracking-tight">
        About <span class="gradient-text">Me</span>
      </h1>
      {about.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <div class="mt-6 text-lg text-[var(--text-muted)] leading-relaxed max-w-2xl prose prose-lg">
            <Content />
          </div>
        );
      })}
    </header>

    <!-- Experience -->
    <section class="mb-16">
      <h2 class="font-display font-800 text-2xl mb-8 flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></span>
        Experience
      </h2>
      <div class="space-y-8">
        {experience.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <div class="relative pl-8 border-l-2 border-[var(--border)]">
              <div class="absolute left-0 top-1 w-3 h-3 -translate-x-[7px] rounded-full bg-[var(--surface-raised)] border-2 border-[var(--color-primary)]" />
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                <h3 class="text-xl font-display font-bold">{entry.data.title}</h3>
                <span class="text-sm font-mono text-[var(--text-muted)]">
                  {formatDate(entry.data.startDate)} — {formatDate(entry.data.endDate)}
                </span>
              </div>
              {entry.data.organization && (
                <p class="text-[var(--color-secondary)] font-medium mb-3">{entry.data.organization}</p>
              )}
              <div class="prose prose-sm text-[var(--text-muted)]">
                <Content />
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-16">
      <h2 class="font-display font-800 text-2xl mb-8 flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-[var(--color-secondary)]"></span>
        Education
      </h2>
      <div class="space-y-8">
        {education.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <div class="relative pl-8 border-l-2 border-[var(--border)]">
              <div class="absolute left-0 top-1 w-3 h-3 -translate-x-[7px] rounded-full bg-[var(--surface-raised)] border-2 border-[var(--color-secondary)]" />
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                <h3 class="text-xl font-display font-bold">{entry.data.title}</h3>
                <span class="text-sm font-mono text-[var(--text-muted)]">
                  {formatDate(entry.data.startDate)} — {formatDate(entry.data.endDate)}
                </span>
              </div>
              {entry.data.organization && (
                <p class="text-[var(--color-secondary)] font-medium mb-3">{entry.data.organization}</p>
              )}
              <div class="prose prose-sm text-[var(--text-muted)]">
                <Content />
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-16">
      <h2 class="font-display font-800 text-2xl mb-8 flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-[var(--color-accent)]"></span>
        Skills
      </h2>
      {skills.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <div class="prose prose-sm max-w-none text-[var(--text-muted)]">
            <Content />
          </div>
        );
      })}
    </section>
  </div>
</BaseLayout>
