---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ProjectCard from '../components/common/ProjectCard.astro';
import BlogPostCard from '../components/common/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">
  <Hero />

  <!-- Featured Projects -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="font-display font-800 tracking-tight">
          Featured <span class="gradient-text">Projects</span>
        </h2>
        <p class="mt-2 text-[var(--text-muted)]">Things I've built and am building</p>
      </div>
      <a href="/projects/" class="hidden sm:inline-flex items-center gap-2 text-sm text-[var(--color-primary)] hover:underline font-medium">
        View all
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          slug={project.id}
          technologies={project.data.technologies}
          featured={project.data.featured}
        />
      ))}
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="font-display font-800 tracking-tight">
          Latest <span class="gradient-text">Posts</span>
        </h2>
        <p class="mt-2 text-[var(--text-muted)]">Writing about things I learn and build</p>
      </div>
      <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-sm text-[var(--color-primary)] hover:underline font-medium">
        View all
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestPosts.map((post) => (
        <BlogPostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- Brief About -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="relative rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-8 sm:p-12 overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-[var(--color-secondary)] rounded-full blur-[100px] opacity-10 -translate-y-1/2 translate-x-1/4"></div>
      <div class="relative max-w-2xl">
        <h2 class="font-display font-800 tracking-tight">About Me</h2>
        <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed">
          I'm a software engineer who believes the best code is the code you don't have to run
          yourself. By day, I build cloud-native systems. By night, I tinker with my homelab,
          automate everything I can, and write about the process.
        </p>
        <a
          href="/about/"
          class="inline-flex items-center gap-2 mt-6 text-[var(--color-primary)] font-semibold hover:underline"
        >
          More about me
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
