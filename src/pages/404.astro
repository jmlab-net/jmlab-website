---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center min-h-[60vh] text-center">
    <div class="text-8xl sm:text-9xl font-display font-800 gradient-text">404</div>
    <p class="mt-4 text-xl text-[var(--text-muted)]">
      This page doesn't exist. Maybe it was automated away.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] font-semibold hover:bg-[var(--color-primary-light)] transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      Back to Home
    </a>
  </div>
</BaseLayout>
