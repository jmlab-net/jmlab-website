---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/common/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const placeholderSlugs = new Set([
  '2026-03-20-automating-content-with-ai',
  '2026-03-15-building-my-homelab',
]);
---

<BaseLayout title="Blog" description="Technical writing about automation, self-hosting, Docker, AI pipelines, and homelab adventures.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <!-- Header -->
    <header class="mb-12">
      <h1 class="font-display font-800 tracking-tight">
        The <span class="gradient-text">Blog</span>
      </h1>
      <p class="mt-3 text-xl text-[var(--text-muted)]">
        Writing about automation, self-hosting, infrastructure, and the occasional deep dive into
        tools I find interesting.
      </p>
    </header>

    <!-- Post list -->
    {posts.length > 0 ? (
      <div class="flex flex-col gap-4">
        {posts.map((post) => (
          <BlogPostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
            placeholder={placeholderSlugs.has(post.id)}
          />
        ))}
      </div>
      <p class="mt-6 text-xs text-[var(--text-muted)]">
        <span class="text-[var(--color-secondary)]">*</span> Placeholder content — retained for site development. Will be replaced with real posts.
      </p>
    ) : (
      <p class="text-[var(--text-muted)]">No posts yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>
