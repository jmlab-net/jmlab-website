---
---

<section class="relative flex items-center overflow-hidden">
  <!-- Animated background -->
  <div class="absolute inset-0 -z-10">
    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(var(--text) 1px, transparent 1px), linear-gradient(90deg, var(--text) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <!-- Gradient orbs -->
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-[var(--color-primary)] rounded-full blur-[128px] opacity-20"></div>
    <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-[var(--color-secondary)] rounded-full blur-[128px] opacity-15"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-[var(--color-accent)] rounded-full blur-[128px] opacity-10"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-14">
    <div class="grid lg:grid-cols-[1fr_auto] gap-12 items-center">
      <!-- Text content -->
      <div class="max-w-3xl">
        <!-- Eyebrow -->
        <div class="reveal flex items-center gap-3 mb-5">
          <div class="h-px w-12 bg-[var(--color-primary)]"></div>
          <span class="text-sm font-mono text-[var(--color-primary)] tracking-wider uppercase">
            Systems Engineer &middot; Algorithm Developer &middot; Homelab Enthusiast
          </span>
        </div>

        <!-- Headline -->
        <h1 class="reveal font-display font-800 tracking-tight leading-[1.05] hero-title">
          Algorithms by day. <span class="gradient-text">Homelab by night.</span>
        </h1>

        <!-- Subhead -->
        <p class="reveal mt-5 text-lg text-[var(--text-muted)] max-w-2xl leading-relaxed">
          15 years building image processing algorithms in the defense & aerospace industry.
          Now integrating AI into everything — from defense workflows to a self-hosted
          stack that runs my content pipeline, automates deployments, and keeps getting smarter.
        </p>

        <!-- CTAs -->
        <div class="reveal mt-8 flex flex-wrap gap-4">
          <a
            href="/projects/"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--color-primary)] font-semibold hover:bg-[var(--color-primary-light)] transition-colors duration-200"
            style="color: #050505;"
          >
            View Projects
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="/cv/"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-[var(--border)] text-[var(--text)] font-semibold hover:border-[var(--color-primary)]/50 hover:bg-[var(--surface-raised)] transition-all duration-200"
          >
            View CV
          </a>
        </div>
      </div>

      <!-- Domain cards — right side -->
      <div class="reveal hidden lg:grid grid-cols-2 gap-3 w-[320px]">
        <div class="p-4 rounded-xl bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--color-primary)]/30 transition-colors">
          <div class="text-2xl mb-2">🎯</div>
          <p class="text-xs font-display font-700 text-[var(--text)]">Image Processing</p>
          <p class="text-[0.7rem] text-[var(--text-muted)] mt-1 leading-snug">Dual-band algorithms for threat detection & tracking</p>
        </div>
        <div class="p-4 rounded-xl bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--color-secondary)]/30 transition-colors">
          <div class="text-2xl mb-2">🧮</div>
          <p class="text-xs font-display font-700 text-[var(--text)]">Simulation & Modeling</p>
          <p class="text-[0.7rem] text-[var(--text-muted)] mt-1 leading-snug">System-level performance assessment & threat modeling</p>
        </div>
        <div class="p-4 rounded-xl bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--color-accent)]/30 transition-colors">
          <div class="text-2xl mb-2">🏠</div>
          <p class="text-xs font-display font-700 text-[var(--text)]">Self-Hosting</p>
          <p class="text-[0.7rem] text-[var(--text-muted)] mt-1 leading-snug">15+ services on Unraid — AI, storage, automation</p>
        </div>
        <div class="p-4 rounded-xl bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--color-primary)]/30 transition-colors">
          <div class="text-2xl mb-2">⚡</div>
          <p class="text-xs font-display font-700 text-[var(--text)]">Automation</p>
          <p class="text-[0.7rem] text-[var(--text-muted)] mt-1 leading-snug">n8n pipelines, AI content generation, zero-touch deploys</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }

  initReveal();
  document.addEventListener('astro:after-swap', initReveal);
</script>

<style>
  .hero-title {
    font-size: clamp(1.8rem, 3.2vw + 0.5rem, 3rem) !important;
  }
</style>
