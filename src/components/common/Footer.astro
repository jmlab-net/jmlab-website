---
const year = new Date().getFullYear();
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/jmlab', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/jmlab', icon: 'linkedin' },
];
---

<footer class="border-t border-[var(--border)] mt-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-6">
        <a href="/" class="font-display text-lg font-bold">
          <span class="gradient-text">JM</span><span class="text-[var(--text-muted)]">Lab</span>
        </a>
        <nav class="flex gap-4" aria-label="Footer navigation">
          {socialLinks.map(({ label, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-muted)] hover:text-[var(--text)] transition-colors text-sm"
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
      <p class="text-sm text-[var(--text-muted)]">
        &copy; {year} JMLab &middot; Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-[var(--color-secondary)] hover:underline">Astro</a>
      </p>
    </div>
  </div>
</footer>
