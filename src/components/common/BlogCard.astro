---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  tags?: string[];
  featured?: boolean;
}

const { title, description, slug, pubDate, tags = [], featured = false } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<article class="group relative">
  <a
    href={`/blog/${slug}/`}
    class:list={[
      'block h-full p-6 rounded-2xl border transition-all duration-200',
      featured
        ? 'border-[var(--color-primary)]/30 bg-[var(--surface)] hover:border-[var(--color-primary)]/60 hover:glow'
        : 'border-[var(--border)] bg-[var(--surface)] hover:bg-[var(--surface-raised)] hover:border-[var(--color-primary)]/30',
    ]}
  >
    <div class="flex items-center gap-3 mb-2">
      {featured && (
        <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-[var(--color-secondary)]/15 text-[var(--color-secondary)]">
          Featured
        </span>
      )}
      <time class="text-xs text-[var(--text-muted)]" datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
    </div>

    <h3 class="text-lg font-display font-bold text-[var(--text)] group-hover:text-[var(--color-primary)] transition-colors">
      {title}
    </h3>

    <p class="mt-2 text-sm text-[var(--text-muted)] line-clamp-2">
      {description}
    </p>

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 text-xs rounded-md bg-[var(--surface-raised)] text-[var(--text-muted)] font-mono">
            {tag}
          </span>
        ))}
        {tags.length > 4 && (
          <span class="px-2 py-0.5 text-xs rounded-md bg-[var(--surface-raised)] text-[var(--text-muted)]">
            +{tags.length - 4}
          </span>
        )}
      </div>
    )}
  </a>
</article>
