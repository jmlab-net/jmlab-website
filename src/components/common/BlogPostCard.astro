---
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group relative">
  <a href={`/blog/${slug}/`} class="block p-6 rounded-2xl border border-[var(--border)] bg-[var(--surface)] hover:bg-[var(--surface-raised)] hover:border-[var(--color-primary)]/30 transition-all duration-200">
    <time class="text-sm text-[var(--text-muted)] font-mono" datetime={pubDate.toISOString()}>
      {formattedDate}
    </time>
    <h3 class="mt-2 text-xl font-display font-bold text-[var(--text)] group-hover:text-[var(--color-primary)] transition-colors">
      {title}
    </h3>
    <p class="mt-2 text-[var(--text-muted)] line-clamp-2">
      {description}
    </p>
    {tags.length > 0 && (
      <div class="mt-4">
        <TagList tags={tags} />
      </div>
    )}
  </a>
</article>
