---
interface Props {
  title: string;
  description: string;
  slug: string;
  technologies: string[];
  featured?: boolean;
}

const { title, description, slug, technologies, featured = false } = Astro.props;
---

<article class="group relative">
  <a
    href={`/projects/${slug}/`}
    class:list={[
      'block h-full p-6 rounded-2xl border transition-all duration-200',
      featured
        ? 'border-[var(--color-primary)]/30 bg-[var(--surface)] hover:border-[var(--color-primary)]/60 hover:glow'
        : 'border-[var(--border)] bg-[var(--surface)] hover:bg-[var(--surface-raised)] hover:border-[var(--color-primary)]/30',
    ]}
  >
    <!-- Placeholder thumbnail -->
    <div class="aspect-video rounded-lg mb-4 overflow-hidden bg-[var(--surface-raised)] flex items-center justify-center">
      <svg class="w-16 h-16 text-[var(--border)]" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="8" y="12" width="48" height="36" rx="4" />
        <path d="M8 20h48" />
        <circle cx="14" cy="16" r="1.5" fill="currentColor" />
        <circle cx="20" cy="16" r="1.5" fill="currentColor" />
        <circle cx="26" cy="16" r="1.5" fill="currentColor" />
        <path d="M20 32l8-6 6 4 10-8" />
      </svg>
    </div>

    {featured && (
      <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-[var(--color-accent)]/15 text-[var(--color-accent)] mb-2">
        Featured
      </span>
    )}

    <h3 class="text-lg font-display font-bold text-[var(--text)] group-hover:text-[var(--color-primary)] transition-colors">
      {title}
    </h3>

    <p class="mt-2 text-sm text-[var(--text-muted)] line-clamp-2">
      {description}
    </p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {technologies.slice(0, 4).map((tech) => (
        <span class="px-2 py-0.5 text-xs rounded-md bg-[var(--surface-raised)] text-[var(--text-muted)] font-mono">
          {tech}
        </span>
      ))}
      {technologies.length > 4 && (
        <span class="px-2 py-0.5 text-xs rounded-md bg-[var(--surface-raised)] text-[var(--text-muted)]">
          +{technologies.length - 4}
        </span>
      )}
    </div>
  </a>
</article>
