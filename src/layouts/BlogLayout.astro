---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/common/TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroImageAlt?: string;
  tags?: string[];
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
  relatedProject?: { slug: string; title: string; description: string };
  relatedPosts?: { slug: string; title: string }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  headings = [],
  prevPost,
  nextPost,
  relatedProject,
  relatedPosts = [],
} = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center gap-3 text-sm text-[var(--text-muted)] mb-4">
        <time datetime={pubDate.toISOString()} class="font-mono">{formattedPubDate}</time>
        {updatedDate && (
          <>
            <span>&middot;</span>
            <span>Updated {formattedUpdatedDate}</span>
          </>
        )}
      </div>
      <h1 class="blog-title font-display font-800 tracking-tight" transition:name={`blog-title-${Astro.url.pathname}`}>
        {title}
      </h1>
      <p class="mt-2 text-base text-[var(--text-muted)]">{description}</p>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <TagList tags={tags} linkable size="md" />
        </div>
      )}
    </header>

    <!-- Two-column layout: sidebar + content -->
    <div class="grid gap-8 lg:grid-cols-[200px_1fr]">
      <!-- Sidebar nav -->
      <aside class="hidden lg:block">
        <nav class="sticky top-24">
          <p class="text-[0.65rem] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3">
            On this page
          </p>
          <ul class="space-y-1 text-sm" id="blog-sidebar-nav">
            <!-- Populated by JS from h2 headings -->
          </ul>

          {/* Related links section — Option E: project callout + secondary links */}
          {(relatedProject || relatedPosts.length > 0) && (
            <div class="sidebar-related">
              <hr class="sidebar-divider" />

              {relatedProject && (
                <a href={`/projects/${relatedProject.slug}/`} class="project-callout group">
                  <div class="project-callout-accent"></div>
                  <p class="project-callout-label">From this project</p>
                  <p class="project-callout-title group-hover:text-[var(--color-primary)] transition-colors">
                    {relatedProject.title}
                  </p>
                  <p class="project-callout-desc">
                    {relatedProject.description} <span class="project-callout-arrow">→</span>
                  </p>
                </a>
              )}

              {relatedPosts.length > 0 && (
                <div class="also-on-jmlab">
                  <p class="also-on-jmlab-label">Also on JMLab</p>
                  <ul class="also-on-jmlab-list">
                    {relatedPosts.map((rp) => (
                      <li>
                        <a href={`/blog/${rp.slug}/`} class="also-on-jmlab-link">
                          {rp.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}
        </nav>
      </aside>

      <!-- Content -->
      <div>
        <div class="post-prose min-w-0">
          <slot />
        </div>

        <!-- Prev/Next navigation -->
        {(prevPost || nextPost) && (
          <nav class="mt-16 pt-8 border-t border-[var(--border)] grid grid-cols-2 gap-4" aria-label="Blog post navigation">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}/`} class="group text-left">
                <span class="text-xs text-[var(--text-muted)] uppercase tracking-wider">Previous</span>
                <p class="mt-1 font-display font-bold text-[var(--text)] group-hover:text-[var(--color-primary)] transition-colors">
                  {prevPost.title}
                </p>
              </a>
            ) : <div />}
            {nextPost ? (
              <a href={`/blog/${nextPost.slug}/`} class="group text-right">
                <span class="text-xs text-[var(--text-muted)] uppercase tracking-wider">Next</span>
                <p class="mt-1 font-display font-bold text-[var(--text)] group-hover:text-[var(--color-primary)] transition-colors">
                  {nextPost.title}
                </p>
              </a>
            ) : <div />}
          </nav>
        )}
      </div>
    </div>
  </div>

</BaseLayout>

<style>
  /* Post title sizing — used by both blog and travel post headers */
  .blog-title {
    font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2.25rem) !important;
  }

  /* Note: prose typography (.post-prose ...) lives in src/styles/global.css
     so it applies to both BlogLayout and TravelLayout. */

  /* Sidebar nav styling */
  #blog-sidebar-nav :global(a) {
    display: block;
    padding: 0.25rem 0.5rem;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.4;
    transition: all 0.15s;
    text-decoration: none;
  }

  #blog-sidebar-nav :global(a:hover) {
    color: var(--text);
    text-decoration: none;
  }

  #blog-sidebar-nav :global(a.active) {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  /* Sidebar related links section */
  .sidebar-related {
    margin-top: 1rem;
  }

  .sidebar-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0 0 1rem 0;
  }

  .project-callout {
    display: block;
    position: relative;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem 0.65rem 0.65rem;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .project-callout:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .project-callout-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent);
    border-radius: 0.4rem 0.4rem 0 0;
  }

  .project-callout-label {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 0.35rem 0;
    line-height: 1;
  }

  .project-callout-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
  }

  .project-callout-desc {
    font-size: 0.7rem;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.4;
  }

  .project-callout-arrow {
    display: inline;
  }

  .also-on-jmlab {
    margin-top: 0.85rem;
  }

  .also-on-jmlab-label {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 0.4rem 0;
    line-height: 1;
  }

  .also-on-jmlab-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .also-on-jmlab-list li {
    margin-bottom: 0.25rem;
  }

  .also-on-jmlab-link {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.15rem 0;
    transition: color 0.15s;
  }

  .also-on-jmlab-link::before {
    content: "·  ";
  }

  .also-on-jmlab-link:hover {
    color: var(--text);
    text-decoration: none;
  }
</style>

<script>
  function initBlogNav() {
    const nav = document.getElementById('blog-sidebar-nav');
    const headings = document.querySelectorAll('.post-prose h2');
    if (!nav || headings.length === 0) return;

    nav.innerHTML = '';

    headings.forEach((h2, i) => {
      if (!h2.id) h2.id = `section-${i}`;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h2.id}`;
      a.textContent = h2.textContent || '';
      li.appendChild(a);
      nav.appendChild(li);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            nav.querySelectorAll('a').forEach((a) => a.classList.remove('active'));
            const active = nav.querySelector(`a[href="#${entry.target.id}"]`);
            if (active) active.classList.add('active');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((h2) => observer.observe(h2));
  }

  initBlogNav();
  document.addEventListener('astro:after-swap', initBlogNav);
</script>
