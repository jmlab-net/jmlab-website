---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  technologies: string[];
  liveUrl?: string;
  repoUrl?: string;
}

const { title, description, technologies, liveUrl, repoUrl } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <!-- Header -->
    <header class="mb-8">
      <a
        href="/projects/"
        class="inline-flex items-center gap-2 text-sm text-[var(--text-muted)] hover:text-[var(--color-primary)] transition-colors font-medium mb-4"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        All Projects
      </a>
      <h1 class="project-title font-display font-800 tracking-tight" transition:name={`project-title-${Astro.url.pathname}`}>
        {title}
      </h1>
      <p class="mt-2 text-base text-[var(--text-muted)]">{description}</p>

      <!-- Tech stack + links row -->
      <div class="mt-4 flex flex-wrap items-center gap-3">
        {technologies.map((tech) => (
          <span class="px-2 py-0.5 text-xs rounded-md bg-[var(--surface-raised)] text-[var(--text-muted)] font-mono border border-[var(--border)]">
            {tech}
          </span>
        ))}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-[var(--color-primary)]/10 text-[var(--color-primary)] border border-[var(--color-primary)]/30 hover:bg-[var(--color-primary)]/20 transition-colors"
            style="color: var(--color-primary);"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
            </svg>
            Live Site
          </a>
        )}
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium text-[var(--text-muted)] border border-[var(--border)] hover:border-[var(--color-primary)]/30 hover:text-[var(--text)] transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            Source
          </a>
        )}
      </div>
    </header>

    <!-- Two-column layout: sidebar + content -->
    <div class="grid gap-8 lg:grid-cols-[200px_1fr]">
      <!-- Sidebar nav -->
      <aside class="hidden lg:block">
        <nav class="sticky top-24">
          <p class="text-[0.65rem] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3">
            On this page
          </p>
          <ul class="space-y-1 text-sm" id="project-sidebar-nav">
            <!-- Populated by JS from h2 headings -->
          </ul>
        </nav>
      </aside>

      <!-- Content -->
      <div class="project-prose min-w-0">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-title {
    font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2.25rem) !important;
  }

  .project-prose :global(h2) {
    font-size: 1.15rem !important;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text);
    font-family: 'Syne Variable', sans-serif;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .project-prose :global(h3) {
    font-size: 1rem !important;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .project-prose :global(p) {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .project-prose :global(ul),
  .project-prose :global(ol) {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }

  .project-prose :global(li) {
    margin-top: 0.15rem;
    margin-bottom: 0.15rem;
  }

  /* Tables */
  .project-prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.82rem;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .project-prose :global(thead) {
    background: var(--surface-raised);
  }

  .project-prose :global(th) {
    padding: 0.6rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--text);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .project-prose :global(td) {
    padding: 0.5rem 1rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .project-prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .project-prose :global(tbody tr:hover) {
    background: var(--surface-raised);
  }

  .project-prose :global(td code) {
    font-size: 0.75rem;
    padding: 0.1rem 0.25rem;
  }

  .project-prose :global(code) {
    font-size: 0.8rem;
    background: var(--surface-raised);
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border);
  }

  .project-prose :global(pre) {
    font-size: 0.8rem;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 1rem;
    border-radius: 0.75rem;
    overflow-x: auto;
  }

  /* Sidebar nav styling */
  #project-sidebar-nav :global(a) {
    display: block;
    padding: 0.25rem 0.5rem;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.4;
    transition: all 0.15s;
    text-decoration: none;
  }

  #project-sidebar-nav :global(a:hover) {
    color: var(--text);
  }

  #project-sidebar-nav :global(a.active) {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
  }
</style>

<script>
  function initProjectNav() {
    const nav = document.getElementById('project-sidebar-nav');
    const headings = document.querySelectorAll('.project-prose h2');
    if (!nav || headings.length === 0) return;

    nav.innerHTML = '';

    headings.forEach((h2, i) => {
      if (!h2.id) h2.id = `section-${i}`;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h2.id}`;
      a.textContent = h2.textContent || '';
      li.appendChild(a);
      nav.appendChild(li);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            nav.querySelectorAll('a').forEach((a) => a.classList.remove('active'));
            const active = nav.querySelector(`a[href="#${entry.target.id}"]`);
            if (active) active.classList.add('active');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((h2) => observer.observe(h2));
  }

  initProjectNav();
  document.addEventListener('astro:after-swap', initProjectNav);
</script>
