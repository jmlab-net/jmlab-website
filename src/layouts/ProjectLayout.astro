---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  technologies: string[];
  liveUrl?: string;
  repoUrl?: string;
}

const { title, description, technologies, liveUrl, repoUrl } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <!-- Header -->
    <header class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-display font-800 tracking-tight" transition:name={`project-title-${Astro.url.pathname}`}>
        {title}
      </h1>
      <p class="mt-4 text-xl text-[var(--text-muted)]">{description}</p>

      <!-- Tech stack -->
      <div class="mt-6 flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <span class="px-3 py-1 text-sm rounded-lg bg-[var(--surface-raised)] text-[var(--text-muted)] font-mono border border-[var(--border)]">
            {tech}
          </span>
        ))}
      </div>

      <!-- Links -->
      {(liveUrl || repoUrl) && (
        <div class="mt-6 flex gap-4">
          {liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] font-semibold hover:bg-[var(--color-primary-light)] transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
              </svg>
              Live Site
            </a>
          )}
          {repoUrl && (
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-[var(--border)] text-[var(--text)] font-semibold hover:border-[var(--color-primary)]/50 hover:bg-[var(--surface-raised)] transition-all text-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
              Source Code
            </a>
          )}
        </div>
      )}
    </header>

    <!-- Image gallery placeholder -->
    <div class="mb-12 rounded-2xl overflow-hidden border border-[var(--border)] bg-[var(--surface)]">
      <div class="aspect-video flex items-center justify-center">
        <div class="text-center">
          <svg class="w-20 h-20 mx-auto text-[var(--border)]" viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="10" y="15" width="60" height="45" rx="6" />
            <path d="M10 25h60" />
            <circle cx="18" cy="20" r="2" fill="currentColor" />
            <circle cx="25" cy="20" r="2" fill="currentColor" />
            <circle cx="32" cy="20" r="2" fill="currentColor" />
            <path d="M25 42l12-10 10 7 18-14" />
            <circle cx="30" cy="38" r="5" />
          </svg>
          <p class="mt-3 text-sm text-[var(--text-muted)]">Project screenshots coming soon</p>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- Back link -->
    <div class="mt-16 pt-8 border-t border-[var(--border)]">
      <a
        href="/projects/"
        class="inline-flex items-center gap-2 text-[var(--text-muted)] hover:text-[var(--color-primary)] transition-colors font-medium"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        All Projects
      </a>
    </div>
  </article>
</BaseLayout>
