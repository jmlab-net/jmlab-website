---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/common/Navigation.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Developer portfolio, blog, and project showcase. Building automation, self-hosting, and AI pipelines.',
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Home' ? 'JMLab' : `${title} — JMLab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-dvh">
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Navigation />
    <main id="main-content" class="flex-1 pt-16">
      <slot />
    </main>
    <Footer />

    <!-- Shared image lightbox — opens on click of any .post-prose img -->
    <dialog class="lightbox" id="post-lightbox">
      <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
      <img alt="" />
    </dialog>

    <script>
      // Delegated click handler so it survives view transitions and
      // doesn't double-bind on after-swap.
      function setupPostLightbox() {
        if (window.__postLightboxInit) return;
        window.__postLightboxInit = true;

        document.addEventListener('click', (e) => {
          const t = e.target;
          if (!t) return;
          const dlg = document.getElementById('post-lightbox');
          if (!dlg) return;
          const dlgImg = dlg.querySelector('img');

          // Open lightbox on any image inside .post-prose
          if (dlgImg && t.tagName === 'IMG' && t.closest('.post-prose')) {
            dlgImg.src = t.src;
            dlgImg.alt = t.alt || '';
            dlg.showModal();
            return;
          }

          // Close button
          if (t.classList && t.classList.contains('lightbox-close')) {
            dlg.close();
            return;
          }

          // Backdrop click (target is the dialog itself, not its children)
          if (t.id === 'post-lightbox') {
            dlg.close();
          }
        });
      }
      setupPostLightbox();
    </script>
  </body>
</html>
